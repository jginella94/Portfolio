@model ObligatorioP3.LogicaAplicacion.DTOs.Historias.DtoHistoriaListado

@{
    ViewData["Title"] = "Eliminar historia";
}

<h1>Eliminar historia #@Model.Id</h1>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="alert alert-warning" role="alert">
    ¿Confirmás que querés eliminar esta historia y sus capítulos y opciones? Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Sinopsis</dt>
    <dd class="col-sm-9">@Model.Sinopsis</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">Id capítulo inicial</dt>
    <dd class="col-sm-9">@Model.IdCapituloInicial</dd>
</dl>

<form asp-controller="Historia" asp-action="Delete" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-controller="Historia" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
