@model ObligatorioP3.WebLectura.Models.VMRankingLectores

@{
    ViewData["Title"] = "Ranking de lectores";
}

<h1 class="mb-4">Ranking de lectores</h1>
<p class="text-muted">Lectores ordenados según la cantidad de historias diferentes completadas.</p>

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">@Model.MensajeError</div>
}
else if (Model.Lectores.Count == 0)
{
    <div class="alert alert-info" role="status">Todavía no hay lectores con historias completadas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Posición</th>
                    <th scope="col">Lector</th>
                    <th scope="col" class="text-end">Historias distintas completadas</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Lectores.Count; i++)
                {
                    var lector = Model.Lectores[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@lector.NombreUsuario</td>
                        <td class="text-end">@lector.CantidadHistoriasCompletadas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
