@model ObligatorioP3.WebLectura.Models.VMRankingHistorias

@{
    ViewData["Title"] = "Ranking de historias";
}

<h1 class="mb-4">Ranking de historias más leídas</h1>
<p class="text-muted">Historias ordenadas por cantidad de lecturas completadas.</p>

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">@Model.MensajeError</div>
}
else if (Model.Historias.Count == 0)
{
    <div class="alert alert-info" role="status">No hay historias con lecturas completadas para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Posición</th>
                    <th scope="col">Historia</th>
                    <th scope="col" class="text-end">Lecturas completadas</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Historias.Count; i++)
                {
                    var historia = Model.Historias[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@historia.Titulo</td>
                        <td class="text-end">@historia.CantidadLecturasCompletadas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
