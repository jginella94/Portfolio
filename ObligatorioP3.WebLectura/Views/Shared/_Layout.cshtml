<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lectura</title>
    <script>
        // Aplicar la preferencia antes de cargar CSS para evitar parpadeos.
        const temaGuardado = localStorage.getItem("tema") || "light";
        document.documentElement.setAttribute("data-bs-theme", temaGuardado);
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Login" asp-action="Index">ObligatorioP3 - Lectura</a>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("token")))
                    {
                        <a class="nav-link" asp-controller="Historias" asp-action="Index">Historias</a>
                        <a class="nav-link" asp-controller="Historial" asp-action="Index">Mis lecturas</a>
                        @if (Context.Session.GetString("rol") == "Administrador")
                        {
                            <a class="nav-link" asp-controller="RankingHistorias" asp-action="Index">Ranking de historias</a>
                            <a class="nav-link" asp-controller="EstadisticasFinales" asp-action="Index">Estadísticas de finales</a>
                            <a class="nav-link" asp-controller="RankingLectores" asp-action="Index">Ranking de lectores</a>
                        }
                        <a class="nav-link" asp-controller="Perfil" asp-action="Index">Mi perfil</a>
                        <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Login" asp-action="Index">Ingresar</a>
                    }
                    <button id="btnTema"
                            type="button"
                            class="btn btn-outline-secondary btn-sm"
                            aria-label="Cambiar tema">
                        <span id="iconoTema" aria-hidden="true">🌙</span>
                        <span id="textoTema">Modo oscuro</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
