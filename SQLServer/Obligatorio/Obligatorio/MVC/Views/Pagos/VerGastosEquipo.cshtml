@using Dominio;

@{
    ViewData["Title"] = "VerGastosEquipo";
}
<div class="container my-4">
    <div class="card shadow-sm">

        <div class="card-header bg-info text-white">
            <h1 class="mb-0">Ver Gastos del Equipo</h1>
        </div>
        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form method="get" action="/pagos/VerGastosEquipo" class="row g-3 mb-4">

                <div class="col-md-6">
                    <label class="form-label">Mes:</label>
                    <select name="m" class="form-select">
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Año:</label>
                    <input type="number" name="a" class="form-control" placeholder="Ej: 2025" />
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </form>

            <table class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Usuario</th>
                        <th>Tipo de Pago</th>
                        <th>Metodo de Pago</th>
                        <th>Descripcion</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Pago p in ViewBag.Listado)
                    {
                        <tr>
                            <td>@p.Usuario.Email</td>
                            <td>@p</td>
                            <td>@p.MetodoPago</td>
                            <td>@p.Descripcion</td>
                            <td>@p.FechaAMostrar().ToShortDateString()</td>
                            <td>@p.CalcularGasto()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
